#| echo: false
#| tbl-colwidths: [10, 20, 70]
areas = data.frame(
nn = c("00", "10", "20", "30", "40", "50", "60", "70", "80", "99"),
Área = c(
"General",
"Funcional",
"Arquitectura",
"Constraints",
"Datos",
"Integración",
"Seguridad",
"Calidad",
"Operación",
"Pendiente de clasificar"
),
Criterio = c(
"Decisiones transversales o relativas al propio funcionamiento de IASI.",
"Qué debe hacer el sistema y qué comportamiento debe ofrecer.",
"Estructura del sistema, componentes, responsabilidades y relaciones.",
"Restricciones que condicionan o limitan las posibles soluciones.",
"Modelos, persistencia, intercambio, ciclo de vida y gobierno del dato.",
"Interfaces, protocolos y comunicación entre sistemas o componentes.",
"Identidad, acceso, protección, amenazas y controles.",
"Validación, pruebas, observabilidad y atributos de calidad.",
"Despliegue, ejecución, configuración, infraestructura y explotación.",
"Decisiones registradas provisionalmente cuya clasificación definitiva todavía no se ha determinado."
)
)
knitr::kable(
areas,
align = c("c", "l", "l")
)
